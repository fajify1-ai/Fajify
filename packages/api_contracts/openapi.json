  "info": {
    "title": "Faji API",
    "description": "Faji server-authoritative API v1",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "keycloak": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LiveStatus": {
        "type": "object",
        "properties": {}
      },
      "ReadyStatus": {
        "type": "object",
        "properties": {}
      },
      "BranchInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "ItemInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "priceMinor": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "priceMinor"
        ]
      },
      "SlotInput": {
        "type": "object",
        "properties": {
          "catalogueId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "capacity": {
            "type": "number"
          }
        },
        "required": [
          "catalogueId",
          "startsAt",
          "endsAt",
          "capacity"
        ]
      },
      "ReservationInput": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string"
          },
          "availabilityId": {
            "type": "string"
          },
          "customerSubject": {
            "type": "string"
          },
          "guests": {
            "type": "number"
          }
        },
        "required": [
          "availabilityId",
          "customerSubject",
          "guests"
        ]
      },
      "ReservationTransition": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "checked_in",
              "completed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "catalogueId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "catalogueId",
          "quantity"
        ]
      },
      "OrderInput": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string"
          },
          "customerSubject": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          }
        },
        "required": [
          "customerSubject",
          "items"
        ]
      },
      "OrderTransition": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "preparing",
              "ready",
              "fulfilled",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "WeeklyHour": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number"
          },
          "opensMinute": {
            "type": "number"
          },
          "closesMinute": {
            "type": "number"
          }
        },
        "required": [
          "weekday",
          "opensMinute",
          "closesMinute"
        ]
      },
      "WeeklyHours": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeeklyHour"
            }
          }
        },
        "required": [
          "slots"
        ]
      },
      "EventConfig": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "maxGuests": {
            "type": "number"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "maxGuests"
        ]
      },
      "PackageLine": {
        "type": "object",
        "properties": {
          "catalogueId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "catalogueId",
          "quantity"
        ]
      },
      "PackageConfig": {
        "type": "object",
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackageLine"
            }
          }
        },
        "required": [
          "components"
        ]
      },
      "Grant": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "branchId": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "role"
        ]
      },
      "BranchUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "contactEmail": {
            "type": "string"
          }
        }
      },
      "CatalogueUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "priceMinor": {
            "type": "number"
          },
          "published": {
            "type": "boolean"
          },
