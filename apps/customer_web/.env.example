# Server-only placeholders. BLOCKED BY PHASE 1 until reviewed and provisioned.
# Never prefix identity secrets with NEXT_PUBLIC_.
FAJI_CUSTOMER_WEB_AUTH_ENABLED=false
FAJI_CUSTOMER_OIDC_ISSUER=
FAJI_CUSTOMER_OIDC_CLIENT_ID=
FAJI_CUSTOMER_OIDC_CLIENT_SECRET=
FAJI_CUSTOMER_OIDC_REDIRECT_URI=
FAJI_CUSTOMER_OIDC_POST_LOGOUT_REDIRECT_URI=
FAJI_CUSTOMER_API_ORIGIN=
FAJI_CUSTOMER_OIDC_SCOPES=
FAJI_CUSTOMER_SESSION_MAX_AGE_SECONDS=
FAJI_CUSTOMER_TRANSACTION_MAX_AGE_SECONDS=
# Approve the exact customer-origin /api/auth/callback URL with Phase 1.
# Dedicated customer-web DB only. No URL query options; TLS verification is mandatory.
FAJI_CUSTOMER_AUTH_DATABASE_URL=
FAJI_CUSTOMER_AUTH_DB_CA_PEM=
FAJI_CUSTOMER_AUTH_DB_MAX_CONNECTIONS=
FAJI_CUSTOMER_AUTH_DB_CONNECT_TIMEOUT_MS=
FAJI_CUSTOMER_AUTH_DB_STATEMENT_TIMEOUT_MS=
FAJI_CUSTOMER_AUTH_DB_LOCK_TIMEOUT_MS=
# Secret manager: JSON object of key IDs to canonical base64 32-byte keys.
FAJI_CUSTOMER_AUTH_ACTIVE_KEY_ID=
FAJI_CUSTOMER_AUTH_KEYS_JSON=
