# Local development only; replace values in an untracked .env file.
FAJI_DATABASE_USER=faji_dev
FAJI_DATABASE_PASSWORD=replace-locally
FAJI_DATABASE_NAME=faji_dev
KEYCLOAK_DATABASE_PASSWORD=replace-separately
KEYCLOAK_ADMIN_PASSWORD=replace-locally
DATABASE_URL=postgresql://faji_dev:replace-locally@localhost:5432/faji_dev
REDIS_URL=redis://localhost:6379
KEYCLOAK_URL=http://localhost:8080

# Native customer registration: backend only. Never put this secret in Flutter.
FAJI_CUSTOMER_REGISTRATION_ENABLED=false
KEYCLOAK_REGISTRATION_CLIENT_ID=faji-customer-registration
KEYCLOAK_REGISTRATION_CLIENT_SECRET=
