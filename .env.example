# Local only. Use separate owner migration and restricted runtime roles in production.
FAJI_DATABASE_USER=faji_dev
FAJI_DATABASE_PASSWORD=replace-locally
FAJI_DATABASE_NAME=faji_dev
FAJI_DATABASE_URL=postgresql://faji_dev:replace-locally@localhost:5433/faji_dev
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
FAJI_WEB_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
FAJI_PLATFORM_ADMIN_OWNER_EMAIL=fajify1@gmail.com
SMTP_URL=smtp://127.0.0.1:1025
AUTH_EMAIL_FROM=Faji <auth@localhost>

# Optional phone delivery: an owned HTTPS sandbox webhook; never commit its credential.
FAJI_SMS_WEBHOOK_URL=
FAJI_SMS_WEBHOOK_SECRET=
# Staging and production registration policy. Staging must explicitly enable self-registration.
FAJI_REGISTRATION_ENABLED=true
# Development payment flow is an internal simulation only; never use provider credentials here.
FAJI_PAYMENT_MODE=simulated
# Leave empty unless requests come exclusively through reviewed ingress networks.
FAJI_TRUSTED_PROXY_CIDRS=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=faji-local
