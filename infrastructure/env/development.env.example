NODE_ENV=development
PORT=3001
LOG_LEVEL=log
FAJI_DATABASE_URL=postgresql://faji:replace-me@127.0.0.1:5432/faji
REDIS_URL=redis://127.0.0.1:6379
KEYCLOAK_ISSUER=http://localhost:8080/realms/faji
KEYCLOAK_AUDIENCE=faji-api
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=faji-dev

# M5 finance (supply real values through untracked environment/secret manager).
# PAYSTACK_SECRET_KEY=sk_test_<operator-secret>
# PAYMENT_CALLBACK_URL=https://<customer-return-page>
# TICKET_SIGNING_KEYS={"v1":"<64-hex-character-secret>"}
# TICKET_ACTIVE_KEY_ID=v1
# FINANCE_RECONCILE_INTERVAL_SECONDS=900
# Run HTTP and `pnpm --filter @faji/api worker:finance` with the same runtime role,
# Paystack domain and signing keys. Configure explicit merchant policy before checkout.
