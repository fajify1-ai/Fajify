NODE_ENV=staging
PORT=3001
LOG_LEVEL=log
FAJI_DATABASE_URL=postgresql://replace-with-secret-manager-staging-value
REDIS_URL=rediss://replace-with-secret-manager-staging-value
S3_ENDPOINT=https://storage.staging.example.invalid
S3_BUCKET=faji-staging
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://api.fajify.com
FAJI_WEB_ORIGINS=https://preview.fajify.com
FAJI_PLATFORM_ADMIN_OWNER_EMAIL=fajify1@gmail.com
SMTP_URL=smtps://configure-provider
AUTH_EMAIL_FROM=Faji <auth@example.invalid>

# Customer/Business unified Next.js service (configure separately from the API):
# FAJI_API_URL=https://api.fajify.com
# FAJI_WEB_ORIGIN=https://preview.fajify.com
# Customer self-registration is separately gated; enable only after policy approval:
FAJI_REGISTRATION_ENABLED=true
