FROM quay.io/keycloak/keycloak:26.8.1 AS builder
ENV KC_DB=postgres
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.1
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY infrastructure/keycloak/realm-faji-m2.json /opt/keycloak/data/import/faji-realm.json
ENV KC_DB=postgres KC_HTTP_ENABLED=true KC_PROXY_HEADERS=xforwarded KC_CACHE=local JAVA_OPTS_KC_HEAP="-Xms96m -Xmx240m"
ENTRYPOINT ["/bin/bash", "-ec", "exec /opt/keycloak/bin/kc.sh start --optimized --import-realm --hostname=\"$RENDER_EXTERNAL_URL\" --http-port=\"$PORT\""]
